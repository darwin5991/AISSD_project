# Local datasets
/02_data/raw/*
!/02_data/raw/.gitkeep

# Reproducible tool outputs
/99_build/*
!/99_build/.gitkeep

# Packaged submission copies
/08_submission/*
!/08_submission/.gitkeep

# Local run outputs and model checkpoints
/07_runs/
/03_model/checkpoints/

# Local test files
/03_model/golden/tests/
/90_scripts/tests/

# Local reference documents and figures
/00_docs/reference/
/00_docs/**/figures/

# Python bytecode and tool caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/

# Temporary editor and operating system files
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
